# Local Wrangler / Pages Functions secrets (never commit the real file)
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Optional PEM from Clerk Dashboard → API keys → Show JWT public key
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Optional extra CORS origins, comma-separated
# ALLOWED_ORIGINS=https://custom-domain.example
# Optional. Comma-separated Clerk emails allowed to edit 教學. Default: smoli0725@gmail.com
# OWNER_EMAIL=smoli0725@gmail.com
# Optional. Public base for cover URLs if the R2 bucket is public (otherwise /covers/{key}).
# COVER_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev
# Web Push (optional). Missing keys disable push; the rest of the site still runs.
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# ALERT_PUSH_SECRET=
# VAPID_SUBJECT=mailto:you@example.com
